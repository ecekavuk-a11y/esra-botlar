########################################################################
# Malatya Esra Telegram Bot Sistemi — Ortam Değişkenleri Şablonu
#
# KULLANIM:
#   cp .env.example .env
#   nano .env    # tüm <DEĞER> alanlarını gerçek değerlerle doldur
#
# UYARI: .env dosyasını ASLA git'e commit etmeyin / paylaşmayın.
# Bu dosyada gerçek token'lar bulunur — sızarsa botlar ele geçirilebilir.
########################################################################

# ──────────────────────────────────────────────────────────────
# BOT TOKENLARI
# ──────────────────────────────────────────────────────────────
# odeme_bot (malatyaesra_odeme_bot) — Ödeme doğrulama, ana webhook
ODEME_BOT_TOKEN=8907710571:<ODEME_BOT_TOKEN_DEGERI>

# Vip_iesrabot — VIP üyelik yönetimi
# ÖNEMLİ: Bu bot ile odeme_bot AYNI Cloudflare Worker URL'sine point ediyordu.
# Docker altyapısına geçişte her biri kendi path'ine ayrılır (/webhook/odeme, /webhook/vip)
VIP_BOT_TOKEN=8934662828:<VIP_BOT_TOKEN_DEGERI>

# esra_arsiv_bot — Arşiv video paylaşım botu
ARSIV_BOT_TOKEN=8888317050:<ARSIV_BOT_TOKEN_DEGERI>

# react_bot — ŞU AN ÖLÜ (webhook yok, polling yok, 33 bekleyen mesaj var)
# Docker'a geçerken bu bot ya yeniden aktive edilmeli ya da kalıcı olarak
# devre dışı bırakılmalı. health-checker bu botu izler ve ölü kalırsa uyarır.
REACT_BOT_TOKEN=8655923137:<REACT_BOT_TOKEN_DEGERI>

# Cicisinibot
CICI_BOT_TOKEN=8721708737:<CICI_BOT_TOKEN_DEGERI>

# Sağlık kontrolcüsünün admin'e DM göndermek için kullanacağı bot token'ı
# (boş bırakılırsa ODEME_BOT_TOKEN kullanılır)
ADMIN_ALERT_BOT_TOKEN=

# ──────────────────────────────────────────────────────────────
# WEBHOOK URL'LERİ (Docker/VPS sonrası YENİ adresler)
# Kendi domain'inizle değiştirin. deploy.sh bu değerleri Telegram'a
# setWebhook ile kaydeder.
# ──────────────────────────────────────────────────────────────
DOMAIN=bot.example.com
ODEME_BOT_WEBHOOK_URL=https://bot.example.com/webhook/odeme
VIP_BOT_WEBHOOK_URL=https://bot.example.com/webhook/vip
ARSIV_BOT_WEBHOOK_URL=https://bot.example.com/webhook/arsiv
CICI_BOT_WEBHOOK_URL=https://bot.example.com/webhook/cici

# ──────────────────────────────────────────────────────────────
# KANALLAR
# ──────────────────────────────────────────────────────────────
FREE_CHANNEL_1_ID=-1003494573579
FREE_CHANNEL_2_ID=-1002956424495
ARSIV_CHANNEL_ID=-1003959424039
ONLINEISRA_CHANNEL_ID=-1003524644687
VIP_CHANNEL_ID=-1003947278046
ADMIN_ID=5019918710

# ──────────────────────────────────────────────────────────────
# SUPABASE (VIP üyelik veritabanı)
# ──────────────────────────────────────────────────────────────
SUPABASE_URL=https://<PROJE_REF>.supabase.co
SUPABASE_KEY=<SUPABASE_SERVICE_ROLE_VEYA_SECRET_KEY>

# ──────────────────────────────────────────────────────────────
# REDIS (state yönetimi — JSON dosya yerine)
# ──────────────────────────────────────────────────────────────
REDIS_PASSWORD=<GUCLU_BIR_SIFRE_URETIN>

# ──────────────────────────────────────────────────────────────
# HEALTH CHECKER AYARLARI
# ──────────────────────────────────────────────────────────────
CHECK_INTERVAL_SECONDS=300
PENDING_UPDATE_ESIK=10
CRON_STALE_HOURS=2
ALERT_COOLDOWN_SECONDS=1800

# ──────────────────────────────────────────────────────────────
# ARŞİV / REACTION / VIP JOB AYARLARI
# ──────────────────────────────────────────────────────────────
MIN_VIDEO_ESIK=5
HTTP_TIMEOUT_SECONDS=25
JOB_TIMEOUT_SECONDS=300

# ──────────────────────────────────────────────────────────────
# NGINX / TLS
# ──────────────────────────────────────────────────────────────
# Let's Encrypt sertifikası için certbot e-posta adresi (deploy.sh içinde kullanılır)
CERTBOT_EMAIL=admin@example.com

# ──────────────────────────────────────────────────────────────
# ESKİ RENDER SERVİSİ (referans — Docker/VPS'e taşındıktan sonra kapatılabilir)
# ──────────────────────────────────────────────────────────────
# RENDER_LEGACY_URL=https://papara-webhook.onrender.com
